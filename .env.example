# BetPlus environment (frontend / Vercel)

# Required in staging and production.
NEXT_PUBLIC_USE_BACKEND=true

# FastAPI origin used by Next.js rewrites (server-side only — never expose DB URLs).
# Set this to the Heroku API URL before building on Vercel.
BACKEND_URL=http://localhost:8000

# development | preview | production (informational for the frontend)
NEXT_PUBLIC_ENVIRONMENT=development

# Admin cookie fallback is disabled when NEXT_PUBLIC_USE_BACKEND=true.
# Sign in with a FastAPI user that has is_admin=true.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# true = only /admin routes (npm run dev:admin). Leave unset for the public app.
# ADMIN_ONLY=false
